# External values supplied by the owner
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
PUBLIC_BASE_URL=http://localhost
OPENROUTER_API_KEY=

# Internal service configuration (Compose-ready defaults)
APP_ENV=development
DEV_AUTH_ENABLED=true
SESSION_SECRET=replace-by-running-scripts-setup
POSTGRES_PASSWORD=replace-by-running-scripts-setup
DATABASE_URL=postgresql+asyncpg://olx_hunter:replace-by-running-scripts-setup@postgres:5432/olx_hunter
REDIS_URL=redis://redis:6379/0
MEDIA_ROOT=/data/media
MEDIA_MAX_BYTES=10000000
MEDIA_MAX_PIXELS=30000000
MEDIA_ALLOWED_HOSTS=olxcdn.com
EXPORT_ROOT=/data/exports
LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DEFAULT_TIMEZONE=Europe/Kyiv
SCAN_INTERVAL_MINUTES=15
SCAN_MAX_PAGES=3
SOURCE_HTTP_ENABLED=false
SOURCE_BROWSER_ENABLED=false
SOURCE_BROWSER_HEADLESS=true
OPENROUTER_MODEL=
# Select an exact ID returned by /api/v1/ai/models. Do not assume an unavailable model ID.
OPENROUTER_RESEARCH_MODEL=
OPENROUTER_DAILY_BUDGET_USD=1.00
APP_DOMAIN=http://localhost
